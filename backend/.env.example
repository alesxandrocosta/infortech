# ============================================================================
# TECHFLOW ERP - Configuração do Backend
# ============================================================================

# Banco de Dados MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=defina-uma-senha-forte
DB_PORT=3306
DB_NAME=bd_infortec

# Server
NODE_ENV=development
PORT=5000

# JWT
JWT_SECRET=gere-um-segredo-com-32-ou-mais-caracteres
JWT_EXPIRY=7d

# CORS: informe a origem do frontend em produção. Em desenvolvimento, IPs privados da rede local são aceitos.
CORS_ORIGIN=http://localhost:5173

# Upload de Arquivos
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
SALES_TAX_RATE=0.0865

# Timezone
TZ=America/Sao_Paulo

# OAuth/OIDC (configure somente os provedores desejados)
OAUTH_REDIRECT_BASE_URL=http://localhost:5000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Primeiro administrador de produção (use apenas no bootstrap)
ADMIN_FULL_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
